{
    "name": "Enquiry",
    "type": "object",
    "properties": {
      "name": {
        "type": "string"
      },
      "email": {
        "type": "string"
      },
      "phone": {
        "type": "string"
      },
      "project_type": {
        "type": "string"
      },
      "location": {
        "type": "string"
      },
      "budget": {
        "type": "string"
      },
      "message": {
        "type": "string"
      },
      "status": {
        "type": "string",
        "enum": [
          "new",
          "in_review",
          "responded",
          "archived"
        ],
        "default": "new"
      }
    },
    "required": [
      "name",
      "message"
    ],
    "rls": {
      "create": {},
      "read": {
        "user_condition": {
          "role": "admin"
        }
      },
      "update": {
        "user_condition": {
          "role": "admin"
        }
      },
      "delete": {
        "user_condition": {
          "role": "admin"
        }
      }
    }
  }